# ==========================================
# ReliefLink Environment Configuration
# Modern Node.js v22+ Production-Ready Setup
# ==========================================

# Server Port (Defaults to 3000 in dev and container)
PORT=3000
NODE_ENV=development

# Authentication Secrets
JWT_SECRET=relieflink-super-secure-production-jwt-secret-key-change-in-prod-2026
JWT_EXPIRES_IN=7d

# Database Configuration:
# ReliefLink supports dual-engine database persistence:
# 1. Embedded Postgres: If DATABASE_URL is left empty or commented, ReliefLink automatically boots
#    an embedded persistent PostgreSQL engine (PGlite) storing tables in ./data/pgdata.
#    Zero installation needed! Works instantly on any machine with Node.js.
# 2. External PostgreSQL: To connect to an external PostgreSQL (AWS RDS, Supabase, Neon, Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/relieflink?schema=public"

# Disaster Escalation Engine (Minutes before an OPEN high/critical request auto-escalates)
ESCALATION_TIMEOUT_MINUTES=15

# Duplicate Detection Engine Thresholds
DUPLICATE_RADIUS_KM=2.0
DUPLICATE_WINDOW_HOURS=12

# Optional Client / App URL
APP_URL="http://localhost:3000"
